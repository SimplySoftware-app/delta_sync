# Copy to server/.env on the host. Do not commit the copy.

# stub skips App Attest and Play Integrity. live requires both.
# /v1/enroll (deprecated, bare public key + stub attestation) exists only in stub.
ATTESTATION_MODE=stub

# Bind inside the container. Caddy reaches this name on the shared network.
# Do not publish 127.0.0.1:8080 on the host.
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/data

# Device certificates. 900 s (15 min) by default, 86400 s (24 h) at most.
DEVICE_CERT_TTL_SECONDS=900

# Comma-separated. Required when ATTESTATION_MODE=live.
# iOS value is the App Attest app id: <TeamID>.<bundle id>
ALLOWED_APP_IDS=
ALLOWED_ANDROID_PACKAGES=cloud.deltasync.capture

# Service-account JSON for Play Integrity decode. Never commit this file.
GOOGLE_PLAY_CREDENTIALS_FILE=

# PKI. If all of these are empty the service creates a root, a Device ICA and a
# Service ICA in DATA_DIR on first boot (keys mode 0600) and does NOT keep the
# root key. For a public host provision them yourself and set all five together.
ROOT_CERT_PATH=
DEVICE_ICA_CERT_PATH=
DEVICE_ICA_KEY_PATH=
SERVICE_ICA_CERT_PATH=
SERVICE_ICA_KEY_PATH=
# Optional. The certificate and key /internal/seal signs with. If empty the
# service issues one from the Service ICA into DATA_DIR and reuses it on restart.
SERVICE_CERT_PATH=
SERVICE_KEY_PATH=

# Shared secret for POST /internal/seal (Authorization: Bearer <value>), at
# least 32 characters. Generate one, for example: openssl rand -hex 32
# Empty leaves /internal/seal answering 503.
MEDIA_SEAL_TOKEN=
# Seals running at once. Each holds several copies of the asset in memory.
SEAL_MAX_CONCURRENCY=2

# RFC 3161 time-stamp authority for service seals. Unset uses the default below.
# Set empty or "off" to disable. If it is on and unreachable, /internal/seal
# answers 502 instead of sealing without a time-stamp.
# TSA_URL=http://timestamp.digicert.com

RUST_LOG=info
