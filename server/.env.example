# Copy to server/.env on the host. Do not commit the copy.

# stub skips App Attest and Play Integrity. live requires both.
ATTESTATION_MODE=stub

# Bind inside the container. Caddy reaches this name on the shared network.
# Do not publish 127.0.0.1:8080 on the host.
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/data

# Short-lived device certificates. 15 minutes.
DEVICE_CERT_TTL_SECONDS=900

# Comma-separated. Required when ATTESTATION_MODE=live.
# iOS value is the App Attest app id: <TeamID>.<bundle id>
ALLOWED_APP_IDS=
ALLOWED_ANDROID_PACKAGES=cloud.deltasync.capture

# Service-account JSON for Play Integrity decode. Never commit this file.
GOOGLE_PLAY_CREDENTIALS_FILE=

# Optional CA override. If unset, the service creates ca.crt.pem and
# ca.key.pem in DATA_DIR on first boot (mode 0600). Back that key up.
CA_CERT_PATH=
CA_KEY_PATH=

RUST_LOG=info
